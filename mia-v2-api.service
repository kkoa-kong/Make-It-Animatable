[Unit]
Description=MIA V2 API and GPU worker pool
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/Make-It-Animatable
Environment=PYTHONUNBUFFERED=1
Environment=MIA_CONFIG=/data/Make-It-Animatable/mia-api.toml
EnvironmentFile=-/etc/default/mia-v2-api
Environment=MIA_TRUSTED_EGRESS_HOSTS=huggingface.co,us.aws.cdn.hf.co,raw.githubusercontent.com,static-oss.neon-arcade.ai
BindReadOnlyPaths=/data/Make-It-Animatable/mia-v2-api.resolv.conf:/etc/resolv.conf
ExecStart=/data/Make-It-Animatable/.venv/bin/python /data/Make-It-Animatable/api_server.py
Restart=on-failure
RestartSec=5
# Let the API drain workers first; kill the entire cgroup on timeout.
KillMode=mixed
TimeoutStopSec=330

[Install]
WantedBy=multi-user.target
