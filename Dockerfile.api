# syntax=docker/dockerfile:1
FROM scratch AS wheelhouse

FROM pytorch/pytorch:2.8.0-cuda12.9-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface \
    HY3DGEN_MODELS=/models/hunyuan \
    MIA_CHECKPOINT_DIR=/models/mia-v2 \
    PORT=8081 \
    MIA_JOBS_DIR=/var/lib/mia-v2/jobs

WORKDIR /app

RUN printf '%s\n' \
        'deb https://mirrors.aliyun.com/ubuntu/ jammy main restricted universe multiverse' \
        'deb https://mirrors.aliyun.com/ubuntu/ jammy-updates main restricted universe multiverse' \
        'deb https://mirrors.aliyun.com/ubuntu/ jammy-security main restricted universe multiverse' \
        > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libsm6 \
        libxext6 \
        libxi6 \
        libxrender1 \
        libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

ENV MIA_ANIMATIONS_DIR=/models/mixamo

COPY api-offline-requirements.txt /app/
RUN --network=none --mount=type=bind,from=wheelhouse,target=/wheels \
    pip install --no-index --find-links=/wheels -r api-offline-requirements.txt \
    && pip check

COPY . /app
RUN chmod +x /app/util/FBX2glTF

ENV MIA_UI=0

EXPOSE 8081
CMD ["python", "/app/api_server.py"]
